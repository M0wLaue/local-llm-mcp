# ==============================================================================
# VORLAGE (.env.example): LOCAL LLM MCP SERVER (DOCKER CONTAINER)
# ==============================================================================
# Kopiere diese Datei nach `.env` (bzw. `.env.<instanzname>` für weitere
# LLM-Endpunkte) und trage deine lokalen Parameter ein:
#   cp .env.example .env
#
# WICHTIG: Die echte `.env`-Datei wird durch `.gitignore` und `.dockerignore`
# ausgeschlossen, damit keine API-Keys oder internen Endpunkte veröffentlicht
# werden.
#
# Kostenschutz-Hinweis: Beim Start des Containers werden KEINE automatischen
# LLM-Abfragen, Batch-Jobs oder Hintergrund-Requests ausgelöst. API-Aufrufe
# erfolgen ausschließlich bei expliziter Nutzung eines MCP-Tools (On-Demand).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INSTANZ- & CONTAINER-IDENTIFIKATION (INSTANCE_NAME)
# ------------------------------------------------------------------------------
# Standardwert: local-llm
# Praxisbegründung:
#   Legt sowohl den Docker-Compose-Projektnamen (`name`), den Containernamen
#   (`container_name`) als auch den internen MCP-Servernamen fest. Dadurch
#   lassen sich beliebig viele LLM-Endpunkte als isolierte Container parallel
#   betreiben, ohne dass sich Container oder Netzwerke überschreiben.
# Fachliche/Technische Grundlage:
#   - Docker Compose Project Name Spezifikation:
#     https://docs.docker.com/compose/how-tos/project-name/
#   - MCP Server-Identifikation (Implementation Info):
#     https://modelcontextprotocol.io/specification/2025-03-26/basic/lifecycle
INSTANCE_NAME=local-llm

# ------------------------------------------------------------------------------
# 2. HOST-PORT DES MCP-SERVERS (MCP_PORT)
# ------------------------------------------------------------------------------
# Standardwert: 8090
# Praxisbegründung:
#   Der lokale TCP-Port auf dem Host-System (gebunden an 127.0.0.1), unter dem
#   MCP-Clients den Server über den Streamable-HTTP-Transport (`/mcp`)
#   erreichen. Jede parallel laufende Container-Instanz benötigt einen eigenen
#   freien Host-Port (z. B. 8090, 8091, 8092).
# Fachliche/Technische Grundlage:
#   - MCP Streamable HTTP Transport Specification:
#     https://modelcontextprotocol.io/specification/2025-03-26/basic/transports#streamable-http
MCP_PORT=8090

# ------------------------------------------------------------------------------
# 3. OPENAI-KOMPATIBLER LLM-ENDPUNKT (LLM_ENDPOINT)
# ------------------------------------------------------------------------------
# Standardwert: http://127.0.0.1:11434/v1
# Praxisbegründung:
#   Basis-URL des lokalen oder entfernten Inferenz-Servers (z. B. Ollama,
#   vLLM, LM Studio, llama.cpp oder OpenAI-Proxy), der die Endpunkte
#   `/chat/completions` und `/models` bereitstellt.
#   WICHTIG: Zeigt die URL auf `127.0.0.1` oder `localhost`, übersetzt der
#   Container diese Adresse bei aktivem `DOCKER_REWRITE_LOCALHOST=true`
#   automatisch nach `host.docker.internal`, damit der Dienst auf dem
#   Host-System aus dem isolierten Docker-Netzwerk erreichbar ist.
# Fachliche/Technische Grundlage:
#   - OpenAI Chat Completions API Reference:
#     https://platform.openai.com/docs/api-reference/chat
#   - Ollama OpenAI Compatibility Guide:
#     https://github.com/ollama/ollama/blob/main/docs/openai.md
LLM_ENDPOINT=http://127.0.0.1:11434/v1

# ------------------------------------------------------------------------------
# 4. STANDARD-SPRACHMODELL (LLM_MODEL)
# ------------------------------------------------------------------------------
# Standardwert: auto
# Praxisbegründung:
#   Gibt das Standardmodell vor, das bei `ask_llm`-Aufrufen verwendet wird,
#   sofern im Tool-Aufruf kein abweichendes Modell (`model`-Override) übergeben
#   wird. Steht der Wert auf `auto` (oder bleibt leer), fragt der MCP-Server
#   beim ersten Aufruf selbstständig `GET /v1/models` ab und wählt das erste
#   auf dem Endpunkt verfügbare Modell aus. Alternativ kann hier ein fester
#   Modellname (z. B. `qwen2.5-coder:32b` oder `llama3.3:70b`) hinterlegt werden.
# Fachliche/Technische Grundlage:
#   - OpenAI Models Endpoint Specification:
#     https://platform.openai.com/docs/api-reference/models/list
LLM_MODEL=auto

# ------------------------------------------------------------------------------
# 5. OPTIONALER API-KEY (LLM_API_KEY)
# ------------------------------------------------------------------------------
# Standardwert: (leer / optional)
# Praxisbegründung:
#   Authentifizierungsschlüssel für den LLM-Endpunkt. Ist ein Wert gesetzt,
#   sendet der MCP-Server bei jedem HTTP-Request den Standard-Header
#   `Authorization: Bearer <LLM_API_KEY>` mit. Ist der Wert leer, wird kein
#   Authorization-Header gesendet.
# Fachliche/Technische Grundlage:
#   - RFC 6750 (The OAuth 2.0 Authorization Framework: Bearer Token Usage):
#     https://datatracker.ietf.org/doc/html/rfc6750
#   - OpenAI API Authentication Specification:
#     https://platform.openai.com/docs/api-reference/authentication
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 6. HTTP-TIMEOUT FÜR INFERENZ-ANFRAGEN IN SEKUNDEN (LLM_TIMEOUT_SECONDS)
# ------------------------------------------------------------------------------
# Standardwert: 180
# Praxisbegründung:
#   Lokale LLMs benötigen beim erstmaligen Laden eines großen Modells in den
#   VRAM (Cold-Start) oder bei langen Reasoning-/Code-Antworten deutlich länger
#   als klassische REST-APIs. Ein Timeout von 180 Sekunden verhindert vorzeitige
#   Verbindungsabbrüche während der Token-Generierung.
# Fachliche/Technische Grundlage:
#   - HTTPX Timeout Configuration Guide:
#     https://www.python-httpx.org/advanced/timeouts/
LLM_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 7. AUTOMATISCHE DOCKER-HOST-AUFLÖSUNG (DOCKER_REWRITE_LOCALHOST)
# ------------------------------------------------------------------------------
# Standardwert: true
# Praxisbegründung:
#   Innerhalb eines Docker-Containers verweist `127.0.0.1` bzw. `localhost`
#   auf den Container selbst und nicht auf den Host-Rechner. Ist dieser
#   Parameter auf `true` gesetzt, ersetzt der MCP-Server `127.0.0.1` und
#   `localhost` in `LLM_ENDPOINT` automatisch durch `host.docker.internal`.
# Fachliche/Technische Grundlage:
#   - Docker Networking (Connect from a container to a service on the host):
#     https://docs.docker.com/desktop/features/networking/#i-want-to-connect-from-a-container-to-a-service-on-the-host
DOCKER_REWRITE_LOCALHOST=true
